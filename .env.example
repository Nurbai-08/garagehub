POSTGRES_DB=garagehub
POSTGRES_USER=garagehub
POSTGRES_PASSWORD=replace_with_a_unique_database_password
DATABASE_URL=postgresql+psycopg://garagehub:replace_with_a_unique_database_password@db:5432/garagehub
JWT_SECRET=replace_with_a_unique_random_secret_of_at_least_32_characters
ENVIRONMENT=development
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
BACKEND_CORS_ORIGINS=http://localhost:5173
ALLOWED_HOSTS=localhost,127.0.0.1,backend
ALLOWED_IMAGE_HOSTS=localhost,127.0.0.1,backend
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_SIZE_MB=4
IMAGE_STORAGE_BACKEND=auto
BLOB_READ_WRITE_TOKEN=
VITE_API_URL=http://localhost:8000/api/v1
